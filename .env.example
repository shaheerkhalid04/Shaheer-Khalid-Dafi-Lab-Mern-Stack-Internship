# ─────────────────────────────────────────────────────────────
#  Copy this file to ".env" and fill in your own values.
#  NEVER commit the real .env — it's already in .gitignore.
# ─────────────────────────────────────────────────────────────

# ── Supabase / Postgres (Task 4) ──
# In Supabase: Project → Settings → Database → Connection string.
# DATABASE_URL  = the "Transaction" pooler string (port 6543). Add ?pgbouncer=true
# DIRECT_URL    = the "Session"/direct string (port 5432), used for migrations.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Resend (Task 5) ──
# Get an API key at https://resend.com → API Keys.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# Who receives the "new contact" alert. Use your own inbox.
CONTACT_TO_EMAIL="shaheerkhalid1404@gmail.com"

# The "from" address. Until you verify a domain in Resend, you can use their
# sandbox sender below. After verifying yourdomain.com, switch to e.g.
# "Shaheer Khalid <hello@yourdomain.com>".
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# Set to "true" to also send the person who wrote in a confirmation email.
SEND_CONFIRMATION="false"

# ── Admin auth (Task 6) ──
# SESSION_SECRET: any long random string (signs the admin session JWT).
# ADMIN_EMAIL / ADMIN_PASSWORD: the first admin user — created by `npm run db:seed`.
SESSION_SECRET="generate-a-long-random-string"
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="a-strong-password"

# ── Google reCAPTCHA v3 (Task 7) ──
# Create keys at https://www.google.com/recaptcha/admin/create (score-based v3).
# Leave empty to disable captcha — login still works, protected by rate limiting.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# ── Keepalive cron ──
# Supabase free-tier projects pause after ~1 week idle, which breaks the
# contact form and admin. vercel.json runs /api/keepalive daily; Vercel sends
# this value as `Authorization: Bearer <CRON_SECRET>` so the endpoint isn't a
# free database ping for anyone who finds it. Any long random string.
CRON_SECRET="generate-a-long-random-string"
